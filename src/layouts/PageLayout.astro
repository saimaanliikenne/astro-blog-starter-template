---
/**
 * PageLayout.astro — Основной layout
 */
import Navigation from '../components/Navigation.astro';
import { ViewTransitions } from 'astro:transitions';

const { title = 'Matkatoimisto Saimaan Liikenne OY', description = 'Unohtumattomat kesälomat Saimaalla' } = Astro.props;
---

<!doctype html>
<html lang="fi" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet" />

    <ViewTransitions fallback="animate" />
  </head>

  <body>
    <!-- Навигация -->
    <Navigation currentPath={Astro.url.pathname} />

    <!-- Основной контент -->
    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="footer">
      <div class="footer-container">
        <div class="footer-brand">
          <h3 class="footer-logo">Matkatoimisto Saimaan Liikenne OY</h3>
          <p>Unohtumattomat hetket Suomen suurimmalla järvellä</p>
        </div>

        <div class="footer-contacts">
          <h4>Yhteystiedot</h4>
          <ul>
            <li>📧 <a href="mailto:info@saimaanliikenne.fi">info@saimaanliikenne.fi</a></li>
            <li>📞 +358 50 556 8889</li>
            <li>📍 Kauppakatu 40 B 27, 53100 Lappeenranta</li>
          </ul>
        </div>

        <div class="footer-social">
          <h4>Seuraa meitä</h4>
          <div class="social-icons">
            <a href="#" target="_blank" rel="noopener noreferrer">Instagram</a>
            <a href="#" target="_blank" rel="noopener noreferrer">Facebook</a>
            <a href="#" target="_blank" rel="noopener noreferrer">Pinterest</a>
          </div>
        </div>
      </div>

      <div class="footer-bottom">
        <p>© {new Date().getFullYear()} Matkatoimisto Saimaan Liikenne OY. Kaikki oikeudet pidätetään.</p>
      </div>
    </footer>

    <style is:global>
      :root {
        --primary: #2a6b5f;
        --accent: #30d5c8;
        --lavender: #E6E6FA;
        --text: #1a2a2a;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: 'Inter', system-ui, sans-serif;
        line-height: 1.6;
        color: var(--text);
        background-color: #E6E6FA;
      }

      h1, h2, h3 {
        font-family: 'Playfair Display', serif;
      }

      a {
        transition: all 0.3s ease;
      }

      /* ===================== FOOTER ===================== */
      .footer {
        background: linear-gradient(135deg, #1e3a5f 0%, #2a6b5f 100%);
        color: #E6E6FA;
        padding: 4.5rem 2rem 2.5rem;
        margin-top: 5rem;
      }

      .footer-container {
        max-width: 1200px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 3rem;
      }

      .footer-logo {
        font-size: 2.1rem;
        color: #E6E6FA;
        margin-bottom: 0.9rem;
      }

      .footer-brand p {
        color: #E6E6FA;
        opacity: 0.95;
        font-size: 1.05rem;
      }

      .footer-contacts h4,
      .footer-social h4 {
        color: #E6E6FA;
        font-size: 1.35rem;
        margin-bottom: 1.3rem;
      }

      .footer-contacts ul {
        list-style: none;
      }

      .footer-contacts li {
        margin-bottom: 0.9rem;
        color: #E6E6FA;
        font-size: 1.05rem;
      }

      .footer a {
        color: #E6E6FA;
        text-decoration: none;
      }

      .footer a:hover {
        color: #ffffff;
        text-decoration: underline;
      }

      .social-icons {
        display: flex;
        gap: 1.6rem;
        flex-wrap: wrap;
      }

      .social-icons a {
        color: #E6E6FA;
        font-size: 1.15rem;
      }

      .social-icons a:hover {
        color: #ffffff;
      }

      .footer-bottom {
        text-align: center;
        margin-top: 3.5rem;
        padding-top: 2rem;
        border-top: 1px solid rgba(230, 230, 250, 0.25);
        color: #E6E6FA;
        opacity: 0.9;
        font-size: 0.98rem;
      }

      /* Адаптивность */
      @media (max-width: 768px) {
        .footer {
          padding: 3.5rem 1.5rem 2rem;
        }

        .footer-container {
          gap: 2.5rem;
        }

        .footer-logo {
          font-size: 1.85rem;
        }
      }
    </style>
  </body>
</html>
