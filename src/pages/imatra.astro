---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout 
  title="Imatra | Kaunis Etelä-Karjala" 
  description="Imatra – kuuluisa Imatrankoski, upea luonto ja rentouttava loma">
  
  <!-- Hero -->
  <div class="hero">
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <h1>Imatra</h1>
      <p class="lead">Voimakas koski, upea luonto ja rentouttava loma</p>
      <a href="#attractions" class="cta-button">Lue lisää kohteista ↓</a>
    </div>
  </div>

  <!-- Intro + Article -->
  <section class="section content-section">
    <div class="container">
      <div class="article-box">

        <h2 class="section-title">Tervetuloa Imatralle</h2>
        
        <p class="intro-text">
          Imatra on yksi Etelä-Karjalan helmistä, tunnettu erityisesti upeasta Imatrankoskesta. 
          Kaupunki tarjoaa ainutlaatuista yhdistelmää luontoa, historiaa ja modernia hyvinvointia.
        </p>

        <h3 class="subsection-title">Imatrankoski – Luonnon voima</h3>
        <p>
          Imatrankoski on yksi Suomen tunnetuimmista luonnonnähtävyyksistä. 
          Vuosisatojen ajan se on houkutellut matkailijoita ympäri maailmaa voimallaan ja kauneudellaan.
        </p>

        <div class="article-image">
          <img src="/images/blog/imatrankoski.jpg" alt="Imatrankoski" loading="lazy">
        </div>

        <h3 class="subsection-title">Imatran Kylpylä ja rentoutuminen</h3>
        <p>
          Moderni kylpylähotelli tarjoaa laadukkaita hoitoja, vesipuiston ja rentouttavia elämyksiä 
          Saimaan kauniissa maisemissa.
        </p>

        <h3 class="subsection-title">Karjalan luonto ja retkeilyreitit</h3>
        <p>
          Imatran ympäristössä on upeita luontopolkuja, järviä ja metsäalueita. 
          Alue sopii erinomaisesti sekä lyhyille kävelyille että pidemmille retkille.
        </p>

        <h3 class="subsection-title">Vinkkejä vierailuun</h3>
        <ul class="tips-list">
          <li>Käy katsomassa koskinäytöstä kesällä</li>
          <li>Vieraile Kruununpuistossa ja Koski-Lahdessa</li>
          <li>Maista paikallisia herkkuja Imatran ravintoloissa</li>
          <li>Varaa majoitus kylpylässä etukäteen kesällä</li>
        </ul>

      </div>
    </div>
  </section>

  <!-- Attractions Cards -->
  <section id="attractions" class="section attractions">
    <div class="container">
      <h2 class="section-title">Suositut nähtävyydet</h2>
      
      <div class="cards-grid">
        <div class="card">
          <img src="/images/blog/imatrankoski.jpg" alt="Imatrankoski" loading="lazy">
          <div class="card-content">
            <h3>Imatrankoski</h3>
            <p>Legendaarinen koski, joka on hurmannut matkailijoita jo yli 200 vuotta. Kesällä koskinäytökset.</p>
          </div>
        </div>

        <div class="card">
          <img src="/images/blog/imatraspa.jpg"  alt="Imatran Kylpylä" loading="lazy">
          <div class="card-content">
            <h3>Imatran Kylpylä</h3>
            <p>Moderni kylpylähotelli, jossa rentoutuminen, vesipuisto ja laadukkaat hoidot.</p>
          </div>
        </div>

        <div class="card">
          <img src="/images/blog/karelia.jpg"  alt="Karjalan luonto" loading="lazy">
          <div class="card-content">
            <h3>Karjalan luonto</h3>
            <p>Kauniit retkeilyreitit, järvet ja metsät ympärillä. Täydellinen luontoharrastajille.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Виджет отелей Иматры -->
  <section class="section widget-section">
    <div class="container">
      <h2 class="section-title">Etsi majoitusta Imatralla</h2>
      <p class="widget-subtitle">Löydä parhaat hotellit, kylpylät ja majoitusvaihtoehdot Imatrasta</p>
      
      <div class="tp-widget-wrapper">
        <script async 
          src="https://tpwgt.com/content?currency=eur&trs=279173&shmarker=498238&show_hotels=true&powered_by=true&locale=fi&destination=Imatra&primary_override=%2332a8dd&color_button=%2332a8dd&color_icons=%2332a8dd&dark=%23262626&light=%23FFFFFF&secondary=%23FFFFFF&special=%23C4C4C4&color_focused=%2332a8dd&border_radius=12&plain=false&promo_id=7879&campaign_id=100" 
          charset="utf-8">
        </script>
      </div>
    </div>
  </section>

</PageLayout>

<style>
  .hero {
    height: 90vh;
    min-height: 650px;
    background: url('/images/blog/imatrankoski.jpg') center/cover no-repeat;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    text-align: center;
    position: relative;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,80,90,0.35), rgba(0,50,70,0.75));
  }

  .hero-content h1 {
    font-size: clamp(3.8rem, 9vw, 7rem);
    font-weight: 800;
    text-shadow: 0 4px 20px rgba(0,0,0,0.5);
  }

  .lead {
    font-size: clamp(1.4rem, 4vw, 2.1rem);
    margin: 1rem 0 2rem;
  }

  .cta-button {
    display: inline-block;
    padding: 1rem 2.4rem;
    background: #00b7b7;
    color: white;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s;
  }

  .cta-button:hover {
    background: #009999;
    transform: translateY(-3px);
  }

  .section {
    padding: 5rem 0;
    background-color: #E6E6FA;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .article-box {
    max-width: 820px;
    margin: 0 auto;
    background: white;
    padding: 3.5rem 3rem;
    border-radius: 24px;
    box-shadow: 0 15px 40px rgba(0,0,0,0.1);
  }

  .section-title {
    text-align: center;
    font-size: 2.6rem;
    margin-bottom: 2rem;
    color: #1a2a2a;
  }

  .subsection-title {
    font-size: 1.8rem;
    margin: 2.8rem 0 1.2rem;
    color: #006666;
  }

  .intro-text {
    text-align: center;
    font-size: 1.2rem;
    line-height: 1.75;
    margin-bottom: 2.5rem;
  }

  .article-image {
    margin: 2.5rem 0;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.12);
  }

  .article-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  .tips-list {
    background: #f8f9f7;
    padding: 1.8rem 2.2rem;
    border-radius: 16px;
    margin-top: 1.5rem;
  }

  .tips-list li {
    margin: 0.9rem 0;
    padding-left: 1.4rem;
    position: relative;
  }

  .tips-list li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: #30d5c8;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .card {
    background: white;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    transition: transform 0.3s ease;
  }

  .card:hover {
    transform: translateY(-10px);
  }

  .card img {
    width: 100%;
    height: 230px;
    object-fit: cover;
  }

  .card-content {
    padding: 1.6rem;
  }

  .card h3 {
    color: #006666;
    margin-bottom: 0.7rem;
  }

  /* Виджет */
  .widget-subtitle {
    text-align: center;
    font-size: 1.15rem;
    color: #555;
    margin-bottom: 2.5rem;
  }

  .tp-widget-wrapper {
    max-width: 900px;
    margin: 0 auto;
    background: white;
    padding: 2rem;
    border-radius: 20px;
    box-shadow: 0 15px 45px rgba(0, 0, 0, 0.12);
  }

  @media (max-width: 768px) {
    .article-box {
      padding: 2.5rem 1.5rem;
    }

    .hero {
      height: 80vh;
      min-height: 550px;
    }

    .tp-widget-wrapper {
      padding: 1.2rem;
      margin: 0 1rem;
    }
  }
</style>
