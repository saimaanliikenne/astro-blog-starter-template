---
import PageLayout from '../layouts/PageLayout.astro';
import CookieConsent from '../components/CookieConsent.astro';
---

<PageLayout 
  title="Matkatoimisto Saimaan Liikenne OY" 
  description="Unohtumattomat lomat Saimaalla – Imatra, Lappeenranta ja Etelä-Karjala">
  
  <!-- Hero -->
  <div class="hero">
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <h1>Tervetuloa<br>Saimaalle</h1>
      <p class="lead">Ainutlaatuisia elämyksiä, upeaa luontoa ja unohtumattomia lomia Etelä-Karjalassa</p>
    </div>
  </div>

  <!-- Текст о ценности края -->
  <section class="section intro-section">
    <div class="container">
      <div class="intro-box">
        <h2>Etelä-Karjalan aarteet</h2>
        <p>
          Saimaan rannat, historialliset kaupungit ja koskematon luonto muodostavat ainutlaatuisen kokonaisuuden. 
          Täällä voit kokea voimaa Imatrankoskella, tutustua Lappeenrannan linnoitukseen ja vaeltaa kansallispuistoissa – 
          kaikki vain lyhyen matkan päässä toisistaan. Etelä-Karjala kutsuu rentoutumaan, tutkimaan ja ihastumaan.
        </p>
      </div>
    </div>
  </section>

  <!-- Все блоки одного размера -->
  <section class="section blocks-section">
    <div class="container">
      <div class="blocks-list">

        <!-- Lappeenranta -->
        <a href="/lappeenranta" class="block-card">
          <div class="block-image">
            <img src="/images/blog/lappeenranta.jpg" alt="Lappeenranta" loading="lazy">
          </div>
          <div class="block-content">
            <span class="label">Kaupunki</span>
            <h3>Lappeenranta</h3>
            <p>
              Saimaan helmi, kaunis satama ja historiallinen linnoitus. 
              Täydellinen yhdistelmä kaupunkielämää, historiaa ja järvimaisemia.
            </p>
            <span class="link-text">Tutustu Lappeenrantaan →</span>
          </div>
        </a>

        <!-- Imatra -->
        <a href="/imatra" class="block-card">
          <div class="block-image">
            <img src="/images/blog/imatrankoski.jpg" alt="Imatra" loading="lazy">
          </div>
          <div class="block-content">
            <span class="label">Luonto & kylpylä</span>
            <h3>Imatra</h3>
            <p>
              Voimakas Imatrankoski, upea Karjalan luonto ja rentouttava kylpyläloma. 
              Yksi Etelä-Karjalan tunnetuimmista kohteista.
            </p>
            <span class="link-text">Tutustu Imatraan →</span>
          </div>
        </a>

        <!-- Kansallispuistot -->
        <a href="/puistot" class="block-card">
          <div class="block-image">
            <img src="/images/blog/ranta.jpg" alt="Kansallispuistot & Retkeily" loading="lazy">
          </div>
          <div class="block-content">
            <span class="label">Retkeily</span>
            <h3>Kansallispuistot & Retkeily</h3>
            <p>
              Petkeljärvi, Ruunaa, Linnansaari ja upeat luontoreitit. 
              Etelä-Karjalan parhaat retkeilykohteet yhdessä paikassa.
            </p>
            <span class="link-text">Tutustu retkeilyyn →</span>
          </div>
        </a>

        <!-- Järvisydän -->
        <a href="https://www.jarvisydan.com/" target="_blank" rel="noopener" class="block-card">
          <div class="block-image">
            <img src="/images/blog/Linnansaari.jpg" alt="Nature Hotel & Spa Resort Järvisydän" loading="lazy">
          </div>
          <div class="block-content">
            <span class="label">Suosittelemme</span>
            <h3>Nature Hotel & Spa Resort Järvisydän</h3>
            <p>
              Saimaan rannalla, Linnansaaren kansallispuiston kupeessa. 
              Majoitus, ruoka, ohjelmapalvelut, Järvikylpylä ja savolainen saunamaailma – myös ryhmille.
            </p>
            <span class="link-text">Tutustu Järvisydämeen →</span>
          </div>
        </a>

      </div>
    </div>
  </section>

  <!-- Gallery -->
  <section class="section gallery-section">
    <div class="container">
      <h2 class="section-title">Galleria – Etelä-Karjala kauneimmillaan</h2>
      <div class="gallery-grid">
        <img src="/images/blog/church.jpg" alt="Saimaa" loading="lazy">
        <img src="/images/blog/imatrasammer.jpg" alt="Lappeenranta" loading="lazy">
        <img src="/images/blog/castle.jpg" alt="Imatrankoski" loading="lazy">
       <img src="/images/blog/karelia.jpg" alt="Imatrankoski" loading="lazy">
       <img src="/images/blog/karhu.jpg" alt="Imatrankoski" loading="lazy">
       <img src="/images/blog/hk_linna.jpg" alt="Imatrankoski" loading="lazy">
      </div>
    </div>
  </section>

  <!-- Video -->
  <section class="section video-section">
    <div class="container">
      <h2 class="section-title">Video: Saimaa kutsuu</h2>
      <div class="video-wrapper">
        <iframe 
          src="https://www.youtube.com/embed/fqvvbWV4KPA" 
          title="Saimaa - Etelä-Karjala" 
          frameborder="0" 
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
          allowfullscreen>
        </iframe>
      </div>
    </div>
  </section>

  <CookieConsent />

</PageLayout>

<style>
  :global(body) {
    background-color: #E6E6FA !important;
  }

  .hero {
    height: 100vh;
    min-height: 680px;
    background: url('/images/hero/finland-hero.jpg') center/cover no-repeat;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #E6E6FA;
    text-align: center;
    position: relative;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0, 80, 90, 0.4), rgba(0, 45, 70, 0.8));
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 900px;
    padding: 0 1.5rem;
  }

  .hero h1 {
    font-size: clamp(3.4rem, 9vw, 6.8rem);
    font-weight: 800;
    line-height: 1.05;
    color: #E6E6FA;
    text-shadow: 0 4px 25px rgba(0,0,0,0.5);
  }

  .lead {
    font-size: clamp(1.35rem, 4.5vw, 2rem);
    margin-top: 1rem;
    color: #E6E6FA;
    opacity: 0.95;
  }

  .section {
    padding: 5rem 0;
    background-color: #E6E6FA;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section-title {
    text-align: center;
    font-size: 2.6rem;
    margin-bottom: 3rem;
    color: #1a2a2a;
  }

  /* Intro текст */
  .intro-section {
    padding-top: 4.5rem;
    padding-bottom: 2rem;
  }

  .intro-box {
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
  }

  .intro-box h2 {
    font-size: 2.4rem;
    color: #1a2a2a;
    margin-bottom: 1.4rem;
  }

  .intro-box p {
    font-size: 1.2rem;
    line-height: 1.8;
    color: #444;
  }

  /* Все блоки одного размера + одинаковый интервал */
  .blocks-list {
    display: flex;
    flex-direction: column;
    gap: 2.5rem; /* одинаковый интервал */
  }

  .block-card {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    background: white;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 12px 35px rgba(0,0,0,0.1);
    text-decoration: none;
    color: inherit;
    transition: transform 0.35s ease, box-shadow 0.35s ease;
    min-height: 300px;
  }

  .block-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 45px rgba(0,0,0,0.15);
  }

  .block-image {
    min-height: 300px;
  }

  .block-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .block-card:hover .block-image img {
    transform: scale(1.05);
  }

  .block-content {
    padding: 2.4rem 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .block-content .label {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #00b7b7;
    margin-bottom: 0.7rem;
  }

  .block-content h3 {
    font-size: 1.8rem;
    color: #1a2a2a;
    margin-bottom: 1rem;
    line-height: 1.25;
  }

  .block-content p {
    font-size: 1.08rem;
    line-height: 1.7;
    color: #444;
    margin-bottom: 1.4rem;
  }

  .link-text {
    color: #00b7b7;
    font-weight: 600;
    font-size: 1.05rem;
  }

  /* Gallery */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.2rem;
  }

  .gallery-grid img {
    width: 100%;
    height: 260px;
    object-fit: cover;
    border-radius: 16px;
    box-shadow: 0 8px 20px rgba(0,0,0,0.1);
    transition: transform 0.4s ease;
  }

  .gallery-grid img:hover {
    transform: scale(1.04);
  }

  /* Video */
  .video-wrapper {
    position: relative;
    padding-bottom: 42%;
    height: 0;
    overflow: hidden;
    border-radius: 20px;
    box-shadow: 0 15px 40px rgba(0,0,0,0.15);
    max-width: 780px;
    margin: 0 auto;
  }

  .video-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  /* Адаптивность */
  @media (max-width: 800px) {
    .block-card {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .block-image {
      min-height: 240px;
    }

    .block-content {
      padding: 2rem 1.8rem;
    }
  }

  @media (max-width: 768px) {
    .hero {
      height: 85vh;
      min-height: 520px;
    }

    .section {
      padding: 4rem 0;
    }

    .section-title {
      font-size: 2.2rem;
    }

    .intro-box h2 {
      font-size: 2rem;
    }

    .intro-box p {
      font-size: 1.1rem;
    }

    .gallery-grid img {
      height: 220px;
    }

    .video-wrapper {
      max-width: 100%;
      padding-bottom: 56.25%;
    }
  }
</style>
