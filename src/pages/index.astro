---
import PageLayout from '../layouts/PageLayout.astro';
import CookieConsent from '../components/CookieConsent.astro';
---

<PageLayout 
  title="Matkatoimisto Saimaan Liikenne OY" 
  description="Unohtumattomat lomat Saimaalla – Imatra, Lappeenranta ja Etelä-Karjala">
  
  <!-- Hero -->
  <div class="hero">
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <h1>Tervetuloa<br>Saimaalle</h1>
      <p class="lead">Ainutlaatuisia elämyksiä, upeaa luontoa ja unohtumattomia lomia Etelä-Karjalassa</p>
      
      <div class="tp-widget-wrapper">
        <script async src="https://tpwgt.com/content?currency=eur&trs=279173&shmarker=498238&show_hotels=true&powered_by=true&locale=fi&searchUrl=search.jetradar.com&primary_override=%2332a8dd&color_button=%2332a8dd&color_icons=%2332a8dd&dark=%23262626&light=%23FFFFFF&secondary=%23FFFFFF&special=%23C4C4C4&color_focused=%2332a8dd&border_radius=0&plain=false&origin=HEL&promo_id=7879&campaign_id=100" charset="utf-8"></script>
      </div>
    </div>
  </div>

  <!-- Destinations Section -->
  <section class="section destinations">
    <div class="container">
      <h2 class="section-title">Löydä unelmiesi kohde</h2>
      <div class="destinations-grid">

        <!-- Lappeenranta -->
        <a href="/lappeenranta" class="destination-card">
          <img src="/images/blog/lappeenranta.jpg" alt="Lappeenranta">
          <div class="card-overlay">
            <h3>Lappeenranta</h3>
            <p>Saimaan helmi, kaunis satama ja vilkas kaupunki</p>
          </div>
        </a>

        <!-- Imatra -->
        <a href="/imatra" class="destination-card">
          <img src="/images/blog/imatrankoski.jpg" alt="Imatra">
          <div class="card-overlay">
            <h3>Imatra</h3>
            <p>Voimakas Imatrankoski ja upea luonto</p>
          </div>
        </a>

        <!-- Retkeily -->
        <a href="/puistot" class="destination-card">
          <img src="/images/blog/ranta.jpg" alt="Retkeily">
          <div class="card-overlay">
            <h3>Kansallispuistot & Retkeily</h3>
            <p>Petkeljärvi, Ruunaa ja upeat luontoreitit</p>
          </div>
        </a>

      </div>
    </div>
  </section>

  <!-- Why Us Section -->
  <section class="section why-us">
    <div class="container">
      <h2 class="section-title">Miksi valita meidät?</h2>
      <div class="features">
        <div class="feature">
          <div class="feature-icon">🌲</div>
          <h3>Lähellä luontoa</h3>
          <p>Autamme sinua löytämään parhaat luontokohteet ja retkeilyreitit.</p>
        </div>
        <div class="feature">
          <div class="feature-icon">🏨</div>
          <h3>Laadukkaat majoitukset</h3>
          <p>Hotellit, kylpylät ja mökit Saimaan rannalla.</p>
        </div>
        <div class="feature">
          <div class="feature-icon">✈️</div>
          <h3>Helppo matkustaminen</h3>
          <p>Lentojen, junien ja majoituksen varaaminen samasta paikasta.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Gallery -->
  <section class="section gallery-section">
    <div class="container">
      <h2 class="section-title">Galleria – Etelä-Karjala kauneimmillaan</h2>
      <div class="gallery-grid">
        <img src="/images/hero/finland-hero.jpg" alt="Saimaa" loading="lazy">
        <img src="/images/blog/lappeenranta.jpg" alt="Lappeenranta" loading="lazy">
        <img src="/images/blog/imatrankoski.jpg" alt="Imatrankoski" loading="lazy">
        
      </div>
    </div>
  </section>

  <!-- Video -->
  <section class="section video-section">
    <div class="container">
      <h2 class="section-title">Video: Saimaa kutsuu</h2>
      <div class="video-wrapper">
        <iframe 
          src="https://www.youtube.com/embed/fqvvbWV4KPA"
          title="Saimaa - Etelä-Karjala" 
          frameborder="0" 
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
          allowfullscreen>
        </iframe>
      </div>
    </div>
  </section>

  <!-- Cookie Consent только на главной -->
  <CookieConsent />

</PageLayout>

<style>
  .hero {
    height: 100vh;
    min-height: 680px;
    background: url('/images/hero/finland-hero.jpg') center/cover no-repeat;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    text-align: center;
    position: relative;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,80,90,0.35), rgba(0,45,70,0.78));
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 900px;
    padding: 0 1.5rem;
  }

  .hero h1 {
    font-size: clamp(3.4rem, 9vw, 6.8rem);
    font-weight: 800;
    line-height: 1.05;
    text-shadow: 0 4px 25px rgba(0,0,0,0.6);
  }

  .lead {
    font-size: clamp(1.35rem, 4.5vw, 2rem);
    margin-top: 1rem;
    opacity: 0.95;
  }

  .tp-widget-wrapper {
    max-width: 720px;
    margin: 2.5rem auto 0;
    background: rgba(255,255,255,0.96);
    border-radius: 20px;
    padding: 1.6rem;
    box-shadow: 0 15px 45px rgba(0,0,0,0.25);
  }

  .section {
    padding: 5.5rem 0;
  }

  .section-title {
    text-align: center;
    font-size: 2.6rem;
    margin-bottom: 3rem;
    color: #1a2a2a;
  }

  .destinations-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.8rem;
    padding: 0 1rem;
  }

  .destination-card {
    position: relative;
    height: 340px;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.12);
  }

  .destination-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .destination-card:hover img {
    transform: scale(1.08);
  }

  .overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.85), transparent);
    color: white;
    padding: 1.8rem 1.5rem 1.5rem;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
    padding: 0 1rem;
  }

  .gallery-grid img {
    width: 100%;
    height: 260px;
    object-fit: cover;
    border-radius: 16px;
    box-shadow: 0 8px 20px rgba(0,0,0,0.1);
  }

  .video-wrapper {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    border-radius: 20px;
    box-shadow: 0 15px 40px rgba(0,0,0,0.15);
    max-width: 1000px;
    margin: 0 auto;
  }

  .video-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  @media (max-width: 768px) {
    .hero {
      height: 85vh;
      min-height: 520px;
    }

    .section {
      padding: 4rem 0;
    }

    .section-title {
      font-size: 2.2rem;
    }

    .destinations-grid {
      grid-template-columns: 1fr;
    }

    .destination-card {
      height: 280px;
    }

    .gallery-grid img {
      height: 220px;
    }

    .tp-widget-wrapper {
      margin: 1.5rem 1rem;
      padding: 1.2rem;
    }
  }
</style>
